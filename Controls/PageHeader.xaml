<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EkseemMaarNet.Controls"
             xmlns:models="clr-namespace:EkseemMaarNet.Models"
             x:Class="EkseemMaarNet.Controls.PageHeader"
             x:DataType="controls:PageHeader"
             x:Name="Root">

    <!-- Back · category icon, then the title on its own line, left-aligned with the content below -->
    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Padding="16,4,16,16">

        <Border Style="{StaticResource IconButton}"
                HorizontalOptions="Start"
                Margin="-10,0,0,0"
                SemanticProperties.Description="Back"
                SemanticProperties.Hint="Returns to the previous page">
            <Label Text="{x:Static models:Icons.Back}"
                   Style="{StaticResource Icon}"
                   TextColor="White"
                   FontSize="24" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding BackCommand, Source={x:Reference Root}}" />
            </Border.GestureRecognizers>
        </Border>

        <Label Grid.Column="1"
               Text="{Binding Glyph, Source={x:Reference Root}}"
               Style="{StaticResource Icon}"
               TextColor="{StaticResource OnWallpaperMuted}"
               FontSize="28"
               VerticalOptions="Center"
               IsVisible="{Binding Glyph, Source={x:Reference Root}, Converter={StaticResource IsNotEmpty}}" />

        <Label Grid.Row="1" Grid.ColumnSpan="2"
               Margin="0,6,0,0"
               Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource PageTitle}"
               SemanticProperties.HeadingLevel="Level1" />

        <Label Grid.Row="2" Grid.ColumnSpan="2"
               Margin="0,2,0,0"
               Text="{Binding Subtitle, Source={x:Reference Root}}"
               Style="{StaticResource OnWallpaperText}"
               TextColor="{StaticResource OnWallpaperMuted}"
               IsVisible="{Binding Subtitle, Source={x:Reference Root}, Converter={StaticResource IsNotEmpty}}" />
    </Grid>
</ContentView>
