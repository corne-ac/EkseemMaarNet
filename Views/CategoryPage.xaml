<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EkseemMaarNet.ViewModels"
             xmlns:models="clr-namespace:EkseemMaarNet.Models"
             xmlns:controls="clr-namespace:EkseemMaarNet.Controls"
             x:Class="EkseemMaarNet.Views.CategoryPage"
             x:DataType="vm:CategoryViewModel"
             SafeAreaEdges="None">

    <Grid SafeAreaEdges="None">
        <controls:WallpaperBackdrop />

        <Grid RowDefinitions="Auto,*"
              SafeAreaEdges="Container">

            <controls:PageHeader Title="{Binding Category.Title}" MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}"
                                 Subtitle="{Binding Category.Subtitle}"
                                 Glyph="{Binding Category.Glyph}"
                                 BackCommand="{Binding BackCommand}" />

            <controls:FadeHost Grid.Row="1">
                <CollectionView MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}"
                                x:Name="SectionsList"
                                Margin="16,0"
                                ItemsSource="{Binding Sections}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <!-- Intro + filter chips -->
                    <CollectionView.Header>
                        <VerticalStackLayout Padding="0,0,0,16" Spacing="16">
                            <Label Text="{Binding Category.Intro}"
                                   Style="{StaticResource OnWallpaperText}"
                                   IsVisible="{Binding Category.Intro, Converter={StaticResource IsNotEmpty}}" />

                            <ScrollView Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never"
                                        IsVisible="{Binding ShowFilters}">
                                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Filters}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterChip">
                                            <Border Style="{StaticResource Chip}"
                                                    SemanticProperties.Description="{Binding Label, StringFormat='Filter: {0}'}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="White" />
                                                        <Setter Property="Stroke" Value="White" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Label}" Style="{StaticResource ChipText}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource ForestGreen}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding SelectFilterCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryViewModel}}}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <!-- One card per section -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SectionView">
                            <Border Style="{StaticResource Card}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Section.IsAlert}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AlertRed}, Dark={StaticResource AlertRedDark}}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Image Source="{AppThemeBinding Light=sprout_forestgreen.png, Dark=sprout_white.png}" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                                               IsVisible="{Binding Section.IsAlert, Converter={StaticResource InvertBool}}" />
                                        <Label Text="{x:Static models:Icons.Warning}" Style="{StaticResource Icon}" FontSize="22"
                                               TextColor="{AppThemeBinding Light={StaticResource AlertRed}, Dark={StaticResource AlertRedDark}}" IsVisible="{Binding Section.IsAlert}" />
                                        <Label Grid.Column="1" Text="{Binding Section.Title}" Style="{StaticResource SectionTitle}"
                                               VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Section.IsAlert}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AlertRed}, Dark={StaticResource AlertRedDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                    <Label Text="{Binding Section.Intro}" Style="{StaticResource Body}" IsVisible="{Binding Section.HasIntro}" />

                                    <VerticalStackLayout Spacing="18" BindableLayout.ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:ContentItem">
                                                <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                    <Label Text="{Binding RatingGlyph}"
                                                           Style="{StaticResource RatingGlyph}"
                                                           controls:RatingTint.Rating="{Binding Rating}"
                                                           IsVisible="{Binding HasRating}" />
                                                    <Image Source="{AppThemeBinding Light=leaf_forestgreen.png, Dark=leaf_white.png}" HeightRequest="16" WidthRequest="16"
                                                           VerticalOptions="Start" Margin="0,4,0,0"
                                                           IsVisible="{Binding HasRating, Converter={StaticResource InvertBool}}" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                        <Label Text="{Binding Name}" Style="{StaticResource ItemName}" />
                                                        <!-- Verdict and our tags on one line: "Best option   BO" -->
                                                        <HorizontalStackLayout Spacing="12">
                                                            <HorizontalStackLayout.Triggers>
                                                                <MultiTrigger TargetType="HorizontalStackLayout">
                                                                    <MultiTrigger.Conditions>
                                                                        <BindingCondition Binding="{Binding HasRating}" Value="False" />
                                                                        <BindingCondition Binding="{Binding HasTags}" Value="False" />
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter Property="IsVisible" Value="False" />
                                                                </MultiTrigger>
                                                            </HorizontalStackLayout.Triggers>
                                                            <Label Text="{Binding RatingLabel}"
                                                                   Style="{StaticResource RatingText}"
                                                                   controls:RatingTint.Rating="{Binding Rating}"
                                                                   IsVisible="{Binding HasRating}" />
                                                            <Label Text="{Binding TagText}"
                                                                   Style="{StaticResource RatingText}"
                                                                   TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}"
                                                                   IsVisible="{Binding HasTags}" />
                                                        </HorizontalStackLayout>
                                                        <Label Text="{Binding Note}" Style="{StaticResource Subtle}" IsVisible="{Binding HasNote}" Margin="0,2,0,0" />

                                                        <!-- "Learn more" is a quiet text link; "Call" (helplines) is a solid button -->
                                                        <Border StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 10"
                                                                BackgroundColor="Transparent"
                                                                Padding="0,8"
                                                                Margin="0,2,0,0"
                                                                MinimumHeightRequest="40"
                                                                HorizontalOptions="Start"
                                                                IsVisible="{Binding HasUrl}"
                                                                SemanticProperties.Description="{Binding LinkLabel}">
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsPhone}" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource ForestGreen}" />
                                                                    <Setter Property="Padding" Value="16,10" />
                                                                    <Setter Property="Margin" Value="0,8,0,0" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <HorizontalStackLayout Spacing="6">
                                                                <Label Text="{Binding LinkGlyph}" Style="{StaticResource Icon}" FontSize="18"
                                                                       TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}">
                                                                    <Label.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding IsPhone}" Value="True">
                                                                            <Setter Property="TextColor" Value="White" />
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                                <Label Text="{Binding LinkLabel}" FontFamily="OpenSansSemibold" FontSize="14" VerticalOptions="Center"
                                                                       TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}">
                                                                    <Label.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding IsPhone}" Value="True">
                                                                            <Setter Property="TextColor" Value="White" />
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                            </HorizontalStackLayout>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding OpenLinkCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryViewModel}}}"
                                                                    CommandParameter="{Binding Url}" />
                                                            </Border.GestureRecognizers>
                                                        </Border>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Sources + home button, straight on the wallpaper -->
                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="0,24,0,32" Spacing="20">
                            <VerticalStackLayout Spacing="10" IsVisible="{Binding Category.HasSources}">
                                <Label Text="Where this comes from" Style="{StaticResource OnWallpaperHeading}" />
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Category.Sources}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:SourceLink">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinimumHeightRequest="36" Padding="0,4">
                                                <Label Text="{x:Static models:Icons.Link}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource OnWallpaperFaint}" VerticalOptions="Start" Margin="0,2,0,0" />
                                                <Label Grid.Column="1" Text="{Binding Title}" FontSize="14" TextColor="{StaticResource OnWallpaper}" TextDecorations="Underline" />
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding OpenLinkCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryViewModel}}}"
                                                        CommandParameter="{Binding Url}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="General info from a family passion project, not medical advice. Check with your doctor or pharmacist before changing any treatment."
                                       FontSize="13" LineHeight="1.3" TextColor="{StaticResource OnWallpaperMuted}" Margin="0,6,0,0" />
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource WallpaperRule}" />

                            <!-- The original "EKSEEM MAAR NET" home button -->
                            <Border Style="{StaticResource BrandButton}" HorizontalOptions="Start" SemanticProperties.Description="Home">
                                <HorizontalStackLayout Spacing="10">
                                    <Image Source="logo_white.png" HeightRequest="26" WidthRequest="26" />
                                    <Label Text="EKSEEM MAAR NET" Style="{StaticResource BrandTitle}" FontSize="18" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding HomeCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </controls:FadeHost>
        </Grid>
    </Grid>
</ContentPage>
