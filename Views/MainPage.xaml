<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EkseemMaarNet.ViewModels"
             xmlns:models="clr-namespace:EkseemMaarNet.Models"
             xmlns:services="clr-namespace:EkseemMaarNet.Services"
             xmlns:controls="clr-namespace:EkseemMaarNet.Controls"
             x:Class="EkseemMaarNet.Views.MainPage"
             x:DataType="vm:MainViewModel"
             SafeAreaEdges="None">

    <Grid SafeAreaEdges="None">
        <controls:WallpaperBackdrop IsHome="True" />

        <Grid RowDefinitions="Auto,Auto,*"
              SafeAreaEdges="Container">

            <!-- Masthead: the original logo and Oswald wordmark, straight on the leaves -->
            <HorizontalStackLayout Grid.Row="0"
                                   MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}"
                                   Padding="16,14,16,0"
                                   Spacing="10">
                <Image Source="logo_white.png"
                       HeightRequest="{OnIdiom Phone=34, Tablet=42, Default=34}"
                       WidthRequest="{OnIdiom Phone=34, Tablet=42, Default=34}"
                       VerticalOptions="Center" />
                <Label Text="EKSEEM MAAR NET"
                       Style="{StaticResource BrandTitle}"
                       FontSize="{OnIdiom Phone=28, Tablet=36, Default=28}"
                       VerticalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1" />
            </HorizontalStackLayout>

            <!-- Search: "is this OK for eczema?" -->
            <VerticalStackLayout Grid.Row="1" Padding="16,4,16,10" Spacing="14"
                                 MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}">
                <Label Text="Your family's quick guide to living with eczema"
                       Style="{StaticResource OnWallpaperText}"
                       TextColor="{StaticResource OnWallpaperMuted}" />
                <Border Style="{StaticResource SearchField}" Padding="14,2,4,2">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="{x:Static models:Icons.Search}" Style="{StaticResource SearchIcon}" />
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Search e.g. coffee, wool, vitamin D"
                               ReturnType="Search"
                               ClearButtonVisibility="Never"
                               SemanticProperties.Description="Search all eczema information" />
                        <Border Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                IsVisible="{Binding IsSearching}"
                                SemanticProperties.Description="Clear search">
                            <Label Text="{x:Static models:Icons.Dismiss}"
                                   Style="{StaticResource Icon}"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearSearchCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Category tiles -->
            <controls:FadeHost Grid.Row="2" IsVisible="{Binding IsSearching, Converter={StaticResource InvertBool}}">
                <CollectionView MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}"
                                x:Name="Tiles"
                                Margin="16,0"
                                ItemsSource="{Binding Categories}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <!-- Today's affirmation (rotates daily from the Motivation page) -->
                        <VerticalStackLayout Padding="0,8,0,18" Spacing="4"
                                             IsVisible="{Binding Affirmation, Converter={StaticResource IsNotEmpty}}"
                                             SemanticProperties.Description="{Binding Affirmation, StringFormat='Today\'s affirmation: {0}'}">
                            <Label Text="Today's affirmation"
                                   Style="{StaticResource RatingText}"
                                   TextColor="{StaticResource OnWallpaperMuted}" />
                            <Label Text="{Binding Affirmation}"
                                   FontFamily="OswaldRegular"
                                   FontSize="{OnIdiom Phone=22, Tablet=28, Default=22}"
                                   TextColor="White" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAffirmationsCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <!-- Solid tile: icon top-left, name bottom-left -->
                            <Border Style="{StaticResource Tile}"
                                    MinimumHeightRequest="{OnIdiom Phone=104, Tablet=150, Default=104}"
                                    SemanticProperties.Description="{Binding Title}"
                                    SemanticProperties.Hint="{Binding Subtitle}">
                                <Grid RowDefinitions="*,Auto" RowSpacing="10">
                                    <Label Text="{Binding Glyph}"
                                           Style="{StaticResource Icon}"
                                           FontSize="{OnIdiom Phone=30, Tablet=42, Default=30}"
                                           TextColor="White"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start" />
                                    <Label Grid.Row="1"
                                           Text="{Binding DisplayTileTitle}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="{OnIdiom Phone=15, Tablet=19, Default=15}"
                                           TextColor="White"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="0,14,0,28" Spacing="14">
                            <BoxView Style="{StaticResource WallpaperRule}" />
                            <!-- Glossary + About (the original "Glossary" link at the bottom) -->
                            <HorizontalStackLayout Spacing="28">
                                <HorizontalStackLayout Spacing="8" MinimumHeightRequest="44" SemanticProperties.Description="Glossary">
                                    <Image Source="sprout_white.png" HeightRequest="22" WidthRequest="22" VerticalOptions="Center" />
                                    <Label Text="Glossary" Style="{StaticResource TextLink}" />
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GlossaryCommand}" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" MinimumHeightRequest="44" SemanticProperties.Description="About and disclaimer">
                                    <Label Text="{x:Static models:Icons.Info}" Style="{StaticResource Icon}" FontSize="20" TextColor="White" />
                                    <Label Text="About" Style="{StaticResource TextLink}" />
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AboutCommand}" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Disclaimer}"
                                   FontSize="13"
                                   LineHeight="1.3"
                                   TextColor="{StaticResource OnWallpaperMuted}" />
                            <Label FontSize="13" TextColor="{StaticResource OnWallpaperFaint}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Information last reviewed " />
                                        <Span Text="{Binding LastReviewed}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </controls:FadeHost>

            <!-- Search results -->
            <controls:FadeHost Grid.Row="2" IsVisible="{Binding IsSearching}">
                <CollectionView MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}"
                                ItemsSource="{Binding Results}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <BoxView HeightRequest="4" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="16,32" Spacing="8" IsVisible="{Binding SearchDone}">
                            <Label Text="Nothing found" Style="{StaticResource OnWallpaperHeading}" FontSize="24" />
                            <Label Text="Try a shorter word, like 'milk' instead of 'full cream milk', or have a look through the categories."
                                   Style="{StaticResource OnWallpaperText}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:SearchResult">
                            <Border Style="{StaticResource Card}" Margin="16,0" Padding="16,14">
                                <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Item.RatingGlyph}"
                                           Style="{StaticResource RatingGlyph}"
                                           controls:RatingTint.Rating="{Binding Item.Rating}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding Item.Name}" Style="{StaticResource ItemName}" />
                                        <Label Text="{Binding Item.RatingLabel}"
                                               Style="{StaticResource RatingText}"
                                               controls:RatingTint.Rating="{Binding Item.Rating}"
                                               IsVisible="{Binding Item.HasRating}" />
                                        <Label Text="{Binding Item.Note}" Style="{StaticResource Subtle}" IsVisible="{Binding Item.HasNote}"
                                               Margin="0,2,0,0" MaxLines="4" LineBreakMode="TailTruncation" />
                                        <Label FontSize="13" Margin="0,6,0,0"
                                               TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Category.Title}" FontFamily="OpenSansSemibold"
                                                          TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding SectionTitle}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{x:Static models:Icons.ChevronRight}"
                                           Style="{StaticResource Icon}"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenResultCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="24" Color="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>
            </controls:FadeHost>
        </Grid>

        <!-- First-launch welcome: what this app is (and isn't) -->
        <Grid IsVisible="{Binding ShowWelcome}" BackgroundColor="#CC061A0F" SafeAreaEdges="None">
            <Border Style="{StaticResource Card}"
                    Margin="20"
                    Padding="24,24,24,20"
                    MaximumWidthRequest="480"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Image Source="logo_green.png" HeightRequest="44" WidthRequest="44" HorizontalOptions="Start" />
                    <Label Text="Welcome to Ekseem Maar Net"
                           Style="{StaticResource SectionTitle}"
                           FontSize="{OnIdiom Phone=26, Tablet=30, Default=26}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Style="{StaticResource Body}"
                           Text="We made this app for our brother, who has had eczema his whole life. It's a family passion project, so the whole family can quickly check what helps and what doesn't." />
                    <Label Style="{StaticResource Body}"
                           Text="It's not a medical app. Everything in here is general info we gathered from public guidelines and research. It isn't medical advice." />
                    <Label Style="{StaticResource Subtle}"
                           Text="For anything about treatment, always check with a doctor, dermatologist or pharmacist." />
                    <Border Style="{StaticResource BrandButton}" Margin="0,8,0,0"
                            SemanticProperties.Description="Got it, continue">
                        <Label Text="Got it" FontFamily="OpenSansSemibold" FontSize="16" TextColor="White" HorizontalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DismissWelcomeCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
