<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EkseemMaarNet.ViewModels"
             xmlns:models="clr-namespace:EkseemMaarNet.Models"
             xmlns:controls="clr-namespace:EkseemMaarNet.Controls"
             x:Class="EkseemMaarNet.Views.GlossaryPage"
             x:DataType="vm:GlossaryViewModel"
             SafeAreaEdges="None">

    <Grid SafeAreaEdges="None">
        <controls:WallpaperBackdrop />

        <Grid RowDefinitions="Auto,Auto,*"
              SafeAreaEdges="Container">

            <controls:PageHeader Title="Glossary" MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}"
                                 Subtitle="Abbreviations and medical words used in the app"
                                 Glyph="{x:Static models:Icons.Book}"
                                 BackCommand="{Binding BackCommand}" />

            <Border Grid.Row="1" Style="{StaticResource SearchField}" Margin="16,0,16,8" Padding="14,2"
                    MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="{x:Static models:Icons.Search}" Style="{StaticResource SearchIcon}" />
                    <Entry Grid.Column="1" Text="{Binding Filter}" Placeholder="Find a term" ClearButtonVisibility="WhileEditing" />
                </Grid>
            </Border>

            <controls:FadeHost Grid.Row="2">
                <CollectionView x:Name="EntriesList" MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}" Margin="16,0" ItemsSource="{Binding Entries}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="32" VerticalItemSpacing="0" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <BoxView HeightRequest="4" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <Label Text="No matching terms."
                               Style="{StaticResource OnWallpaperText}"
                               Padding="0,32" />
                    </CollectionView.EmptyView>
                    <!-- A plain definition list on the leaves: term, meaning, detail, then a thin rule -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GlossaryEntry">
                            <VerticalStackLayout Spacing="4" Padding="0,14,0,0">
                                <Label Text="{Binding Term}" FontFamily="OswaldSemiBold" FontSize="{OnIdiom Phone=22, Tablet=26, Default=22}" TextColor="White" />
                                <Label Text="{Binding Meaning}" Style="{StaticResource ItemName}" TextColor="White" />
                                <Label Text="{Binding Detail}" Style="{StaticResource OnWallpaperText}" TextColor="{StaticResource OnWallpaperMuted}"
                                       FontSize="{OnIdiom Phone=14, Tablet=16, Default=14}" IsVisible="{Binding HasDetail}" />
                                <BoxView Style="{StaticResource WallpaperRule}" Margin="0,14,0,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="24" Color="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>
            </controls:FadeHost>
        </Grid>
    </Grid>
</ContentPage>
