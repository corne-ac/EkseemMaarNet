<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EkseemMaarNet.ViewModels"
             xmlns:models="clr-namespace:EkseemMaarNet.Models"
             xmlns:controls="clr-namespace:EkseemMaarNet.Controls"
             x:Class="EkseemMaarNet.Views.GlossaryPage"
             x:DataType="vm:GlossaryViewModel"
             SafeAreaEdges="None">

    <Grid SafeAreaEdges="None">
        <controls:WallpaperBackdrop />

        <Grid RowDefinitions="Auto,Auto,*"
              SafeAreaEdges="Container">

            <controls:PageHeader Title="Glossary" MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}"
                                 Subtitle="Abbreviations and medical words used in the app"
                                 Glyph="{x:Static models:Icons.Book}"
                                 BackCommand="{Binding BackCommand}" />

            <Border Grid.Row="1" Style="{StaticResource SearchField}" Margin="16,0,16,12" Padding="14,2"
                    MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="{x:Static models:Icons.Search}" Style="{StaticResource SearchIcon}" />
                    <Entry Grid.Column="1" Text="{Binding Filter}" Placeholder="Find a term" ClearButtonVisibility="WhileEditing" />
                </Grid>
            </Border>

            <controls:FadeHost Grid.Row="2">
            <CollectionView x:Name="EntriesList" MaximumWidthRequest="{x:Static controls:Responsive.MaxContentWidth}" Margin="16,0" ItemsSource="{Binding Entries}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <BoxView HeightRequest="4" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GlossaryEntry">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Term}" Style="{StaticResource SectionTitle}" FontSize="22" />
                                    <Label Text="{Binding Meaning}" Style="{StaticResource ItemName}" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource Subtle}" IsVisible="{Binding HasDetail}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="24" Color="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>
            </controls:FadeHost>
        </Grid>
    </Grid>
</ContentPage>
