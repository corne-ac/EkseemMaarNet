<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Implicit styles ===== -->

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=15, Tablet=17, Default=15}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- ===== Typography ===== -->

    <Style x:Key="BrandTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OswaldRegular" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CharacterSpacing" Value="1.5" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OswaldSemiBold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=25, Tablet=34, Default=25}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="OnWallpaperText" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=15, Tablet=18, Default=15}" />
        <Setter Property="TextColor" Value="#E6FFFFFF" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OswaldSemiBold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=20, Tablet=24, Default=20}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=15, Tablet=17, Default=15}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="Subtle" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=16, Default=14}" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <Style x:Key="ItemName" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=16, Tablet=19, Default=16}" />
    </Style>

    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="FluentIcons" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Rating icon + "BEST OPTION" caption on item rows (colour comes from controls:RatingTint) -->
    <Style x:Key="RatingGlyph" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="Overline" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <!-- ===== Surfaces ===== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Opacity="0.18" Radius="16" Offset="0,6" />
        </Setter>
    </Style>

    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource GlassStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="BackgroundColor" Value="{StaticResource GlassFill}" />
    </Style>

    <Style x:Key="GlassPill" TargetType="Border" BasedOn="{StaticResource GlassPanel}">
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="PillText" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Rounded white search box with its icon (Home and Glossary) -->
    <Style x:Key="SearchField" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    </Style>

    <Style x:Key="SearchIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style x:Key="IconButton" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="BackgroundColor" Value="{StaticResource GlassFill}" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="BrandButton" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="BackgroundColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Opacity="0.25" Radius="10" Offset="0,4" />
        </Setter>
    </Style>

</ResourceDictionary>
