<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Design rules (kept deliberately small, see README "Design"):
    - Text sits straight on the wallpaper where it's short; long reading text sits on one solid surface.
    - Home tiles are solid deep green (not glass), left-aligned like index cards.
    - No glass, no drop shadows, no gradients beyond the wallpaper scrim.
    - Radii by role: 12 for reading surfaces, 10 for inputs and buttons, full pill only for filter chips.
    - Hierarchy from Oswald (titles) against Open Sans (reading), and from weight and size, not capitals.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Implicit styles ===== -->

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=15, Tablet=17, Default=15}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource DeepGreen}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- ===== Typography ===== -->

    <Style x:Key="BrandTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OswaldRegular" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CharacterSpacing" Value="1.5" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OswaldSemiBold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=30, Tablet=40, Default=30}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="OnWallpaperText" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=15, Tablet=18, Default=15}" />
        <Setter Property="TextColor" Value="{StaticResource OnWallpaper}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <!-- Small heading straight on the wallpaper (e.g. "Where this comes from") -->
    <Style x:Key="OnWallpaperHeading" TargetType="Label">
        <Setter Property="FontFamily" Value="OswaldRegular" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=19, Tablet=22, Default=19}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OswaldSemiBold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=21, Tablet=25, Default=21}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=15, Tablet=17, Default=15}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="Subtle" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=16, Default=14}" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
    </Style>

    <Style x:Key="ItemName" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=16, Tablet=19, Default=16}" />
    </Style>

    <!-- The verdict line under an item ("Best option"). Colour comes from controls:RatingTint. -->
    <Style x:Key="RatingText" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=13, Tablet=15, Default=13}" />
    </Style>

    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="FluentIcons" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="RatingGlyph" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- ===== Surfaces ===== -->

    <!-- The one reading surface: solid, flat, no shadow -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Padding" Value="18,18" />
    </Style>

    <!-- Home category tile: solid, flat, left-aligned like an index card -->
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{StaticResource TileFill}" />
        <Setter Property="Padding" Value="12,12,10,12" />
    </Style>

    <!-- Thin rule between groups inside a card -->
    <Style x:Key="Hairline" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
    </Style>

    <!-- Thin rule straight on the wallpaper -->
    <Style x:Key="WallpaperRule" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource OnWallpaperLine}" />
    </Style>

    <!-- Filter chips: the only pill shape in the app -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource OnWallpaperMuted}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style x:Key="ChipText" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- A tappable line of text with an icon, straight on the wallpaper (Glossary, About) -->
    <Style x:Key="TextLink" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SearchField" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    </Style>

    <Style x:Key="SearchIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <!-- 44pt tap target around a bare icon (no circle behind it) -->
    <Style x:Key="IconButton" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="BrandButton" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="BackgroundColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

</ResourceDictionary>
