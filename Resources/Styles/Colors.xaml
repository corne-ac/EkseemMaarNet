<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Brand (from the original app) -->
    <Color x:Key="ForestGreen">#155634</Color>
    <Color x:Key="EkseemGreen">#4F8541</Color>
    <Color x:Key="DeepGreen">#0B2E1C</Color>

    <!-- Reading surfaces: a green-tinted off-white, not pure white; a deep green-grey in dark mode -->
    <Color x:Key="CardLight">#FAFBF8</Color>
    <Color x:Key="CardDark">#131D17</Color>
    <Color x:Key="TextLight">#1A2820</Color>
    <Color x:Key="TextDark">#E6EEE8</Color>
    <Color x:Key="SubtleTextLight">#55645A</Color>
    <Color x:Key="SubtleTextDark">#A3B4A8</Color>
    <Color x:Key="AccentLight">#155634</Color>
    <Color x:Key="AccentDark">#8FC98A</Color>
    <Color x:Key="HairlineLight">#DDE4DC</Color>
    <Color x:Key="HairlineDark">#28362D</Color>

    <!-- Text and lines placed straight on the wallpaper -->
    <Color x:Key="OnWallpaper">#F5FFFFFF</Color>
    <Color x:Key="OnWallpaperMuted">#CCFFFFFF</Color>
    <Color x:Key="OnWallpaperFaint">#A6FFFFFF</Color>
    <Color x:Key="OnWallpaperLine">#40FFFFFF</Color>

    <!-- Urgent sections -->
    <Color x:Key="AlertRed">#B3261E</Color>
    <Color x:Key="AlertRedDark">#FF8A80</Color>

</ResourceDictionary>
